# Logging
LOG_LEVEL=INFO

# Local vLLM server
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
LLM_CONTEXT_WINDOW=2048
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.0
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=120

# Embeddings and chunking (must match the stored index)
EMBEDDING_MODEL=ai-forever/ru-en-RoSBERTa
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=512
EMBEDDING_QUERY_PREFIX=search_query:
EMBEDDING_DOCUMENT_PREFIX=search_document:
CHUNK_SIZE_TOKENS=192
CHUNK_OVERLAP_TOKENS=32

# Dense-first hybrid retrieval
BM25_TOP_K=8
DENSE_TOP_K=8
RETRIEVAL_TOP_K=3
HYBRID_BM25_INSERT_POSITION=2
HYBRID_BM25_MAX_RANK=1
HYBRID_BM25_SLOTS=1

# 900 context + 550 prompt reserve + 500 completion <= 2048
RAG_CONTEXT_MAX_TOKENS=900
PROMPT_OVERHEAD_RESERVE_TOKENS=550

# Storage
MODEL_CACHE_DIR=.cache/huggingface
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
INDEX_DIR=data/index
